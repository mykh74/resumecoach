# Production Environment Variables for ResumeCoach
# Copy this file to .env.production and fill in the values

# ============================================
# LLM Provider Configuration
# ============================================

# Primary LLM provider (openai or sagemaker)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# AWS SageMaker Configuration (if using sagemaker provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name

# ============================================
# Application Configuration
# ============================================

# Environment
ENVIRONMENT=production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.resumecoach.com

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=https://resumecoach.streamlit.app,https://app.resumecoach.com

# ============================================
# Database Configuration (Optional)
# ============================================

# PostgreSQL (if using RDS)
DATABASE_URL=postgresql://user:password@host:5432/resumecoach
# or
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=resumecoach
DB_USER=resumecoach
DB_PASSWORD=your-secure-db-password

# Redis (if using ElastiCache)
REDIS_URL=redis://your-redis-endpoint:6379/0
REDIS_HOST=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# ============================================
# Storage Configuration
# ============================================

# S3 for file storage (optional)
S3_BUCKET_NAME=resumecoach-uploads
S3_REGION=us-east-1

# Local storage path (if not using S3)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes

# ============================================
# Security Configuration
# ============================================

# Secret key for session management
SECRET_KEY=your-long-random-secret-key-here-generate-with-openssl

# JWT Configuration (if implementing authentication)
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/resumecoach/app.log

# CloudWatch (if using AWS CloudWatch Logs)
ENABLE_CLOUDWATCH=true
CLOUDWATCH_LOG_GROUP=/aws/resumecoach/api
CLOUDWATCH_LOG_STREAM=production

# ============================================
# Monitoring Configuration
# ============================================

# Application Insights
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry (optional error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Performance Configuration
# ============================================

# Gunicorn workers
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=300

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================
# Feature Flags
# ============================================

ENABLE_SAGEMAKER=false
ENABLE_CACHING=true
ENABLE_ASYNC_PROCESSING=false

# ============================================
# Cost Optimization
# ============================================

# LLM API rate limits (requests per minute)
OPENAI_RPM_LIMIT=50
SAGEMAKER_RPM_LIMIT=100

# Cache TTL (seconds)
CACHE_TTL_RESUME=3600
CACHE_TTL_JOB=3600
CACHE_TTL_ANALYSIS=7200

# ============================================
# Backup Configuration
# ============================================

ENABLE_BACKUPS=true
BACKUP_S3_BUCKET=resumecoach-backups
BACKUP_RETENTION_DAYS=30

# ============================================
# Maintenance
# ============================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please check back soon."

# ============================================
# Generation Instructions
# ============================================

# Generate SECRET_KEY:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Generate JWT_SECRET_KEY:
# openssl rand -hex 32

# Test configuration:
# python -c "from dotenv import load_dotenv; load_dotenv('.env.production'); import os; print('✅ All required vars set' if os.getenv('OPENAI_API_KEY') else '❌ Missing vars')"
